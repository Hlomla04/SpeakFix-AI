# ─── Database (Supabase Postgres) ───
# Get this from: Supabase dashboard → Project Settings → Database → Connection string → URI
# Replace [YOUR-PASSWORD] with your database password (URL-encode special chars: $ → %24)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ─── Supabase Auth ───
# Get these from: Supabase dashboard → Project Settings → API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_[YOUR-PUBLISHABLE-KEY]
SUPABASE_SECRET_KEY=sb_secret_[YOUR-SECRET-KEY]
SUPABASE_JWKS_URL=https://[YOUR-PROJECT-REF].supabase.co/auth/v1/.well-known/jwks.json

# ─── NVIDIA Integrate API (OpenAI-compatible) ───
# Get a free key at https://integrate.api.nvidia.com/
NVIDIA_API_KEY=nvapi_[YOUR-NVIDIA-KEY]
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.3-flash

# ─── TTS voice for "Iris" ───
# Options: tongtong (default, warm female) | xiaochen (professional female) | chuichui (lively female) | kazi | douji | luodo | jam (male)
SPEAKFIX_TTS_VOICE=tongtong
